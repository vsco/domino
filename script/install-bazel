#!/usr/bin/env bash
set -euo pipefail

# Install Bazelisk as `bazel`.
# Bazelisk reads .bazelversion from the workspace root and downloads
# the correct Bazel version automatically, so no BAZEL_VERSION env var is needed.

BAZELISK_VERSION="1.25.0"
INSTALL_DIR="${HOME}/.local/bin"
mkdir -p "${INSTALL_DIR}"

case "$(uname -s)" in
  Linux)
    case "$(uname -m)" in
      x86_64)  BAZELISK_ASSET="bazelisk-linux-amd64" ;;
      aarch64) BAZELISK_ASSET="bazelisk-linux-arm64" ;;
      *)        echo "Unsupported Linux arch: $(uname -m)"; exit 1 ;;
    esac
    ;;
  Darwin)
    case "$(uname -m)" in
      x86_64)  BAZELISK_ASSET="bazelisk-darwin-amd64" ;;
      arm64)   BAZELISK_ASSET="bazelisk-darwin-arm64" ;;
      *)        echo "Unsupported macOS arch: $(uname -m)"; exit 1 ;;
    esac
    ;;
  *)
    echo "Unsupported OS: $(uname -s)"
    exit 1
    ;;
esac

BAZELISK_URL="https://github.com/bazelbuild/bazelisk/releases/download/v${BAZELISK_VERSION}/${BAZELISK_ASSET}"

# Skip download if the correct version is already installed.
if command -v bazel &>/dev/null && bazel version 2>/dev/null | grep -q "Bazelisk version: v${BAZELISK_VERSION}"; then
  echo "Bazelisk ${BAZELISK_VERSION} already installed at $(command -v bazel), skipping download."
  exit 0
fi

echo "Downloading Bazelisk ${BAZELISK_VERSION} (${BAZELISK_ASSET})..."
curl -fsSL "${BAZELISK_URL}" -o "${INSTALL_DIR}/bazel"
chmod +x "${INSTALL_DIR}/bazel"

# Ensure the install dir is on PATH for subsequent Travis steps.
export PATH="${INSTALL_DIR}:${PATH}"
echo "export PATH=\"${INSTALL_DIR}:\${PATH}\"" >> ~/.bashrc

echo "Bazelisk installed as \`bazel\` at ${INSTALL_DIR}/bazel"
bazel version
