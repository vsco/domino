module(
    name = "domino",
    version = "0.1",
    repo_name = "com_github_vsco_domino",
)

bazel_dep(name = "bazel_features", version = "1.27.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_go", version = "0.53.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.38.0", repo_name = "bazel_gazelle")

# ── Go toolchain ──────────────────────────────────────────────────────────────
go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.24.10")

# ── Go module dependencies (managed via go.mod / go.sum) ─────────────────────
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# List every external repo that BUILD.bazel (this module) directly references.
# Transitive deps are resolved automatically by go_deps and don't need to be
# listed here unless a BUILD file in *this* repo imports them directly.
use_repo(
    go_deps,
    "com_github_aws_aws_sdk_go",
    "com_github_stretchr_testify",
)
